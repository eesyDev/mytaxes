---
import '../styles/global.css'

interface ArticleSchema {
  authorName: string
  authorTitle?: string
  datePublished: string
  dateModified?: string
  mentions?: string[]
}

interface CalculatorSchema {
  name: string
  description: string
}

interface Props {
  title: string
  description?: string
  article?: ArticleSchema
  calculator?: CalculatorSchema
  breadcrumbs?: Array<{ name: string; item?: string }>
  pageType?: string
}

const {
  title,
  description = 'Калькулятор налогов Казахстан 2026. Рассчитайте налоги для ИП и ТОО быстро и бесплатно.',
  article,
  calculator,
  breadcrumbs,
  pageType = 'WebPage',
} = Astro.props

const baseUrl = 'https://mytaxes.kz'
const currentUrl = new URL(Astro.url.pathname, baseUrl).href

const schemas: object[] = [
  {
    '@type': 'Organization',
    '@id': `${baseUrl}/#organization`,
    name: 'MyTaxes.kz',
    description: 'Онлайн-сервис для расчёта налогов ИП и физлиц Казахстана. Актуальные ставки 2026 года.',
    url: baseUrl,
    logo: {
      '@type': 'ImageObject',
      '@id': `${baseUrl}/#logo`,
      url: `${baseUrl}/favicon.svg`,
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${baseUrl}/#website`,
    url: baseUrl,
    name: 'MyTaxes.kz',
    description: 'Калькулятор налогов Казахстан 2026',
    inLanguage: 'ru',
    publisher: { '@id': `${baseUrl}/#organization` },
  },
  {
    '@type': pageType,
    '@id': `${currentUrl}#webpage`,
    url: currentUrl,
    name: title,
    description,
    isPartOf: { '@id': `${baseUrl}/#website` },
    publisher: { '@id': `${baseUrl}/#organization` },
    inLanguage: 'ru',
  },
]

if (article) {
  const authorId = `${baseUrl}/#person-${article.authorName.replace(/\s+/g, '_')}`

  schemas.push({
    '@type': 'Person',
    '@id': authorId,
    name: article.authorName,
    ...(article.authorTitle ? { jobTitle: article.authorTitle } : {}),
    worksFor: { '@id': `${baseUrl}/#organization` },
  })

  schemas.push({
    '@type': 'Article',
    '@id': `${currentUrl}#article`,
    headline: title,
    description,
    author: { '@id': authorId },
    publisher: { '@id': `${baseUrl}/#organization` },
    datePublished: article.datePublished,
    dateModified: article.dateModified ?? article.datePublished,
    mainEntityOfPage: { '@id': `${currentUrl}#webpage` },
    ...(article.mentions?.length
      ? { mentions: article.mentions.map((name) => ({ '@type': 'DefinedTerm', name })) }
      : {}),
    inLanguage: 'ru',
  })

  schemas.push({
    '@type': 'BreadcrumbList',
    '@id': `${currentUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: baseUrl },
      { '@type': 'ListItem', position: 2, name: 'Статьи', item: `${baseUrl}/blog` },
      { '@type': 'ListItem', position: 3, name: title, item: currentUrl },
    ],
  })
}

if (calculator) {
  schemas.push({
    '@type': 'WebApplication',
    '@id': `${currentUrl}#webapp`,
    name: calculator.name,
    description: calculator.description,
    url: currentUrl,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KZT',
    },
    provider: { '@id': `${baseUrl}/#organization` },
  })

  schemas.push({
    '@type': 'BreadcrumbList',
    '@id': `${currentUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: baseUrl },
      { '@type': 'ListItem', position: 2, name: calculator.name, item: currentUrl },
    ],
  })
}

if (breadcrumbs?.length) {
  schemas.push({
    '@type': 'BreadcrumbList',
    '@id': `${currentUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      ...(crumb.item ? { item: crumb.item } : {}),
    })),
  })
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': schemas })

const ogType = article ? 'article' : 'website'
const ogImage = `${baseUrl}/og-image.png`
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="_OQXWII4T_Av5SBj3O66yzD5P2DvWWiTp7rbDQZMy5g" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | MyTaxes.kz</title>

    <!-- Open Graph -->
    <meta property="og:site_name" content="MyTaxes.kz" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={`${title} | MyTaxes.kz`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {article && <meta property="article:modified_time" content={article.dateModified ?? article.datePublished} />}
    {article && <meta property="article:author" content={article.authorName} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | MyTaxes.kz`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">

    <!-- Header -->
    <header class="border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight">
          mytaxes<span class="text-blue-600">.kz</span>
        </a>
        <nav class="flex gap-6 text-sm text-gray-600">
          <a href="/calculators/ip" class="hover:text-blue-600 transition-colors">Калькуляторы</a>
          <a href="/blog" class="hover:text-blue-600 transition-colors">Статьи</a>
        </nav>
      </div>
    </header>

    <!-- Main -->
    <main class="max-w-5xl mx-auto px-4 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-100 mt-20">
      <div class="max-w-4xl mx-auto px-4 py-8 text-sm text-gray-400">
        <p>© 2026 mytaxes.kz — Калькулятор налогов Казахстан. Информация носит справочный характер.</p>
        <div class="flex items-center justify-between flex-wrap gap-2 mt-1">
          <a href="/legal" class="text-xs text-gray-400 tracking-widest hover:text-blue-600 transition-colors border-b border-transparent hover:border-blue-600 pb-1">
            Юридическая информация
          </a>
          <a href="https://eezydev.net/" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-400 hover:text-blue-600 transition-colors">
            designed & created by EEZYDEV
          </a>
        </div>
      </div>
      
    </footer>

  </body>
</html>
