---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Калькулятор налогов Казахстан 2026. Рассчитайте налоги для ИП и ТОО быстро и бесплатно.' } = Astro.props
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="_OQXWII4T_Av5SBj3O66yzD5P2DvWWiTp7rbDQZMy5g" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | MyTaxes.kz</title>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">

    <!-- Header -->
    <header class="border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight">
          mytaxes<span class="text-blue-600">.kz</span>
        </a>
        <nav class="flex gap-6 text-sm text-gray-600">
          <a href="/calculators/ip" class="hover:text-blue-600 transition-colors">Калькуляторы</a>
          <a href="/blog" class="hover:text-blue-600 transition-colors">Статьи</a>
        </nav>
      </div>
    </header>

    <!-- Main -->
    <main class="max-w-5xl mx-auto px-4 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-100 mt-20">
      <div class="max-w-4xl mx-auto px-4 py-8 text-sm text-gray-400">
        <p>© 2026 mytaxes.kz — Калькулятор налогов Казахстан. Информация носит справочный характер.</p>
        <div class="flex items-center justify-between flex-wrap gap-2 mt-1">
          <a href="/legal" class="text-xs text-gray-400 tracking-widest hover:text-blue-600 transition-colors border-b border-transparent hover:border-blue-600 pb-1">
            Юридическая информация
          </a>
          <a href="https://eezydev.net/" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-400 hover:text-blue-600 transition-colors">
            designed & created by EEZYDEV
          </a>
        </div>
      </div>
      
    </footer>

  </body>
</html>
