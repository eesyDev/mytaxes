---
interface Props {
  name: string
  role: string
  photo?: string
  updated?: string
}

const { name, role, photo, updated } = Astro.props
---

<div class="flex items-center gap-4 border border-gray-100 rounded-2xl p-5 bg-gray-50 my-10">
  {photo ? (
    <img
      src={photo}
      alt={name}
      class="w-14 h-14 rounded-full object-cover flex-shrink-0"
    />
  ) : (
    <div class="w-14 h-14 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0 text-blue-600 text-xl font-bold">
      {name.charAt(0)}
    </div>
  )}
  <div class="flex-1 min-w-0">
    <p class="font-semibold text-gray-900 text-base">{name}</p>
    <p class="text-sm text-gray-500">{role}</p>
  </div>
  {updated && (
    <div class="text-xs text-gray-400 text-right flex-shrink-0">
      <span class="block">Обновлено</span>
      <span class="font-medium text-gray-500">{updated}</span>
    </div>
  )}
</div>
