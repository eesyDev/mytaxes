---
import Layout from '../layouts/Layout.astro'

// Подтягиваем мета статей напрямую из блога, чтобы заголовки и описания не дублировались
const modules = import.meta.glob('./blog/*.astro', { eager: true })
const allPosts = Object.entries(modules)
  .filter(([, mod]) => (mod as any).meta)
  .map(([path, mod]) => ({
    ...(mod as any).meta,
    slug: path.replace('./blog/', '').replace('.astro', ''),
  }))

// Подборка для главной — 6 статей с разным охватом тем
const featuredSlugs = [
  'ip-uproshchenniy-rezhim-2026',
  'patent-dlya-ip-2026',
  'too-uproshchenka',
  'crypto',
  'freelance',
  'nalogovye-vychety',
]
const featured = featuredSlugs
  .map((slug) => {
    const post = allPosts.find((p) => p.slug === slug)
    // Предупреждаем при сборке, если статья из подборки не найдена или без meta —
    // иначе карточка молча исчезнет с главной.
    if (!post) console.warn(`[index] featured-статья не найдена: ${slug}`)
    return post
  })
  .filter(Boolean) as Array<{ slug: string; title: string; description: string; category: string }>

// FAQ — структура на 10 вопросов
const faqs = [
  {
    q: 'Какие ставки налога для ИП в 2026 году?',
    a: 'На упрощённом режиме — 4% от дохода, на патенте — 1%. Дополнительно ИП платит социальные платежи (ОПВ, СО, ВОСМС, ОПВР) от заявленного дохода.',
  },
  {
    q: 'Когда нужно вставать на учёт по НДС?',
    a: 'Порог постановки на учёт по НДС в 2026 году — 20 000 МРП за календарный год. При превышении нужно встать на учёт в течение установленного срока, иначе грозит штраф.',
  },
  {
    q: 'Чем патент отличается от упрощёнки?',
    a: 'Патент — ставка 1%, но жёсткие ограничения по видам деятельности и без наёмных сотрудников. Упрощёнка — ставка 4%, можно нанимать работников и шире список ОКЭД.',
  },
  {
    q: 'Нужно ли платить налог с переводов на Kaspi?',
    a: 'Сам по себе перевод между физлицами налогом не облагается. Но регулярные поступления за товары и услуги налоговая может расценить как предпринимательский доход — тогда нужно регистрировать ИП.',
  },
  {
    q: 'Как считается налог на криптовалюту?',
    a: 'Доход от продажи крипты облагается ИПН 10% с прибыли (разница между ценой продажи и покупки). Доход фиксируется в тенге по курсу Нацбанка на дату операции и декларируется в форме 270.00.',
  },
  {
    q: 'Что такое форма 240.00 и кто её сдаёт?',
    a: 'Это декларация по индивидуальному подоходному налогу для физлиц с доходами из-за рубежа: дивиденды, акции, крипта, зарубежная недвижимость. Срок сдачи — до 31 марта следующего года.',
  },
  {
    q: 'Какие налоговые вычеты доступны физлицам?',
    a: 'Стандартный вычет 14 МРП в месяц, вычет 1 МЗП, вычеты на медицину, добровольные пенсионные взносы, вознаграждение по ипотеке Отбасы банка и взносы на ВОСМС.',
  },
  {
    q: 'Как платят налоги фрилансеры?',
    a: 'Самый удобный вариант — оформить ИП на упрощёнке или через приложение e-Salyq Business со ставкой 1%. Это легализует доход и снимает риски при крупных переводах на карту.',
  },
  {
    q: 'Какой налог при продаже квартиры или авто?',
    a: 'Если имущество в собственности менее года и продано дороже, чем куплено — ИПН 10% с прироста стоимости. Доход декларируется в форме 270.00.',
  },
  {
    q: 'Что будет, если не задекларировать доход?',
    a: 'Штраф за неуплату налога может достигать значительной части суммы, плюс пеня за просрочку и риск блокировки счетов по линии финмониторинга. Декларировать выгоднее, чем скрывать.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}

// Базовые ставки по годам
const baseRates = [
  { label: 'МЗП', y2026: '85 000 тнг', y2025: '85 000 тнг' },
  { label: 'МРП', y2026: '4 325 тнг', y2025: '3 932 тнг' },
  { label: 'КПН', y2026: '20 %', y2025: '20 %' },
  { label: 'ИПН', y2026: '10 / 15 %', y2025: '10 %' },
  { label: 'ОПВ', y2026: '10 %', y2025: '10 %' },
  { label: 'ОППВ', y2026: '5 %', y2025: '5 %' },
  { label: 'ОПВР', y2026: '3.5 %', y2025: '2.5 %' },
  { label: 'Социальный налог', y2026: '6 %', y2025: '11 %' },
  { label: 'Социальные отчисления', y2026: '5 %', y2025: '5 %' },
  { label: 'НДС', y2026: '16 %', y2025: '12 %' },
  { label: 'ООСМС', y2026: '3 %', y2025: '3 %' },
  { label: 'ВОСМС', y2026: '2 %', y2025: '2 %' },
  { label: 'Единый платеж', y2026: '24.8 %', y2025: '23.8 %' },
]

// Пределы для исчисления (минимум / максимум) по годам
const limits: Record<string, Array<{ label: string; min: string; max: string }>> = {
  '2026': [
    { label: 'ОПВ', min: 'нет', max: '425 000 ₸' },
    { label: 'СО', min: '4 250 ₸', max: '29 750 ₸' },
    { label: 'ОСМС', min: 'нет', max: '102 000 ₸' },
    { label: 'ВОСМС', min: 'нет', max: '34 000 ₸' },
    { label: 'ОПВР', min: '2 975 ₸', max: '148 750 ₸' },
  ],
  '2025': [
    { label: 'ОПВ', min: 'нет', max: '425 000 ₸' },
    { label: 'СО', min: '4 250 ₸', max: '29 750 ₸' },
    { label: 'ОСМС', min: 'нет', max: '25 500 ₸' },
    { label: 'ВОСМС', min: 'нет', max: '17 000 ₸' },
    { label: 'ОПВР', min: '2 125 ₸', max: '106 250 ₸' },
  ],
}
---

<Layout title="Калькулятор налогов Казахстан 2026">

  <!-- Hero -->
  <section class="text-center py-14">
    <h1 class="text-4xl font-bold tracking-tight mb-4">
      Калькулятор налогов<br />Казахстан 2026
    </h1>
    <p class="text-gray-500 text-lg max-w-xl mx-auto">
      Быстро рассчитайте налоги для ИП и ТОО. Актуальные ставки 2026 года.
    </p>
  </section>

  <!-- Calculator cards -->
  <section class="grid sm:grid-cols-2 gap-4 mb-20">
    <a href="/calculators/ip" class="group border border-gray-200 rounded-2xl p-6 hover:border-blue-400 hover:shadow-sm transition-all">
      <div class="text-2xl mb-3">📊</div>
      <h2 class="font-semibold text-lg mb-1">ИП — упрощённый режим и патент</h2>
      <p class="text-sm text-gray-500">4% на упрощёнке, 1% на патенте. Ставки 2026 года.</p>
      <span class="mt-4 inline-block text-sm text-blue-600 group-hover:underline">Рассчитать →</span>
    </a>
    <a href="/calculators/forma-240" class="group border border-gray-200 rounded-2xl p-6 hover:border-blue-400 hover:shadow-sm transition-all">
      <div class="text-2xl mb-3">📄</div>
      <h2 class="font-semibold text-lg mb-1">Форма 240 — инвестиции</h2>
      <p class="text-sm text-gray-500">ИПН с дивидендов, акций, крипты и зарубежных доходов.</p>
      <span class="mt-4 inline-block text-sm text-blue-600 group-hover:underline">Рассчитать →</span>
    </a>
  </section>

  <!-- Rates & limits section -->
  <section id="rates" class="bg-gray-50 rounded-3xl p-6 sm:p-8 mb-20">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <h2 class="text-xl font-bold">Ставки и лимиты</h2>
      <div class="inline-flex self-start bg-gray-100 rounded-full p-1" role="tablist" aria-label="Выбор года">
        <button type="button" data-year-btn="2026" role="tab" class="year-btn rounded-full px-5 py-1.5 text-sm font-medium transition-colors">2026</button>
        <button type="button" data-year-btn="2025" role="tab" class="year-btn rounded-full px-5 py-1.5 text-sm font-medium transition-colors">2025</button>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- Базовые ставки -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6">
        <h3 class="font-semibold mb-2">Базовые ставки</h3>
        <div class="divide-y divide-gray-100 text-sm">
          {baseRates.map(r => (
            <div class="flex items-center justify-between gap-4 py-3">
              <span class="text-gray-600">{r.label}</span>
              <span class="font-semibold text-gray-900 whitespace-nowrap">
                <span data-year="2026">{r.y2026}</span>
                <span data-year="2025" hidden>{r.y2025}</span>
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Пределы для исчисления -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6">
        <h3 class="font-semibold mb-2">Пределы для исчисления</h3>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-gray-400 text-xs uppercase tracking-wide">
              <th class="text-left font-medium py-2">Исчисления</th>
              <th class="text-right font-medium py-2">Минимум</th>
              <th class="text-right font-medium py-2">Максимум</th>
            </tr>
          </thead>
          {Object.entries(limits).map(([year, rows]) => (
            <tbody data-year={year} hidden={year !== '2026'} class="divide-y divide-gray-100">
              {rows.map(r => (
                <tr>
                  <td class="py-3 text-gray-600">{r.label}</td>
                  <td class="py-3 text-right text-gray-700 whitespace-nowrap">{r.min}</td>
                  <td class="py-3 text-right font-semibold text-gray-900 whitespace-nowrap">{r.max}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>

  <!-- Blog section -->
  <section class="mb-20">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold">Статьи о налогах</h2>
      <a href="/blog" class="text-sm text-blue-600 hover:underline">Все статьи →</a>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      {featured.map(post => (
        <a href={`/blog/${post.slug}`} class="group border border-gray-100 rounded-2xl p-6 hover:border-gray-300 transition-all">
          <span class="text-xs text-gray-400 uppercase tracking-wide">{post.category}</span>
          <h3 class="font-semibold mt-1 mb-2 group-hover:text-blue-600 transition-colors">
            {post.title}
          </h3>
          <p class="text-sm text-gray-500">{post.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ section -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold">Частые вопросы</h2>
    </div>
    <div class="space-y-3">
      {faqs.map(item => (
        <details class="group border border-gray-200 rounded-2xl px-6 open:border-gray-300 transition-all">
          <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer list-none group-hover:text-blue-600 transition-colors">
            <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">{item.q}</h3>
            <span class="shrink-0 text-gray-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="text-sm text-gray-500 leading-relaxed pb-5 -mt-1">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <script>
    const section = document.getElementById('rates')
    if (section) {
      const buttons = section.querySelectorAll<HTMLButtonElement>('[data-year-btn]')
      const setYear = (year: string) => {
        section.querySelectorAll<HTMLElement>('[data-year]').forEach((el) => {
          el.hidden = el.dataset.year !== year
        })
        buttons.forEach((b) => {
          const active = b.dataset.yearBtn === year
          b.classList.toggle('bg-white', active)
          b.classList.toggle('shadow-sm', active)
          b.classList.toggle('text-gray-900', active)
          b.classList.toggle('text-gray-500', !active)
          b.setAttribute('aria-selected', String(active))
        })
      }
      buttons.forEach((b) => b.addEventListener('click', () => setYear(b.dataset.yearBtn!)))
      setYear('2026')
    }
  </script>

</Layout>
