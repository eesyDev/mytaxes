---
import Layout from '../../layouts/Layout.astro'
import SalaryCalculator from '../../components/SalaryCalculator.astro'
import FaqSection from '../../components/FaqSection.astro'
import FeaturedPosts from '../../components/FeaturedPosts.astro'
import { TAX_YEAR } from '../../data/tax-rates-2026.js'

const faqs = [
  {
    q: 'Чем расчёт зарплаты на упрощёнке отличается от ОУР?',
    a: 'Единственное отличие — социальный налог: на упрощёнке он не начисляется на зарплату подушево, а входит в единый налог с оборота. Все остальные платежи (ОПВ, ВОСМС, ИПН, СО, ОПВР, ООСМС) считаются идентично ОУР.',
  },
  {
    q: 'Платит ли ТОО на упрощёнке социальный налог за работника?',
    a: 'Нет. Социальный налог 6% с зарплаты на упрощёнке не платится — он «зашит» в единый налог с оборота, который сдаётся по форме 910.00 раз в полгода.',
  },
  {
    q: 'Какие взносы удерживаются и платятся на упрощёнке?',
    a: 'Из зарплаты удерживаются ОПВ 10%, ВОСМС 2% и ИПН 10/15%. Работодатель платит СО 5%, ОПВР 3,5% и ООСМС 3%. Отличие от ОУР — отсутствие соцналога с зарплаты.',
  },
  {
    q: 'Какая ставка налога с оборота на упрощёнке?',
    a: 'Налог с оборота (упрощённая декларация) составляет 3–4% в зависимости от региона и сдаётся раз в полгода по форме 910.00. Это налог бизнеса, а не подушевой платёж за каждого работника.',
  },
  {
    q: 'Есть ли выгода по стоимости найма на упрощёнке?',
    a: 'Да. Поскольку соцналог 6% с зарплаты не платится, полная стоимость найма на упрощёнке ниже, чем на ОУР, на величину этого соцналога. Калькулятор показывает эту экономию.',
  },
  {
    q: 'Как считается ИПН работника на упрощёнке?',
    a: 'Так же, как на ОУР: 10% с базы (оклад минус ОПВ, минус ВОСМС, минус вычеты), 15% с части свыше 8 500 МРП за год. Базовый вычет 30 МРП применяется одинаково.',
  },
  {
    q: 'Действует ли базовый вычет 30 МРП на упрощёнке?',
    a: 'Да, вычет 30 МРП (129 750 ₸) применяется на упрощёнке точно так же, как на ОУР — для резидентов РК по основному месту работы.',
  },
  {
    q: 'Кто может применять упрощённую декларацию (упрощёнку)?',
    a: 'Режим доступен при соблюдении лимитов по обороту, численности работников и разрешённым видам деятельности. При превышении лимитов ТОО переходит на общеустановленный режим.',
  },
  {
    q: 'Как считается зарплата при неполном месяце и у нерезидента на упрощёнке?',
    a: 'В месяц найма/увольнения оклад делится по дням, а минимальные базы не применяются. У нерезидента ИПН плоский без вычетов и взносов; социальный налог не платится в любом случае (упрощёнка).',
  },
  {
    q: 'Нужно ли вставать на учёт по НДС на упрощёнке?',
    a: 'Да, при обороте свыше 20 000 МРП за календарный год постановка на учёт по НДС обязательна независимо от режима налогообложения.',
  },
]
---

<Layout
  title={`Калькулятор зарплаты ТОО на упрощёнке (УСН) ${TAX_YEAR}`}
  description="Расчёт зарплаты на руки и налогов работодателя для ТОО на упрощённом режиме (УСН) в Казахстане 2026. Социальный налог не платится подушево — входит в налог с оборота."
  calculator={{
    name: `Калькулятор зарплаты ТОО на упрощёнке ${TAX_YEAR}`,
    description: 'Расчёт зарплаты на руки и стоимости найма для ТОО на упрощённой декларации (УСН). Ставки 2026 года.',
  }}
>
  <SalaryCalculator
    mode="simplified"
    direction="direct"
    active="too-usn"
    heading={`Калькулятор зарплаты ТОО на упрощёнке ${TAX_YEAR}`}
    subheading="Зарплата на руки и стоимость найма · ТОО · упрощённая декларация"
  />

  <div class="max-w-6xl mx-auto px-4 mt-16">
    <FeaturedPosts />
    <FaqSection faqs={faqs} />
  </div>
</Layout>
