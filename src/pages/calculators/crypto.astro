---
import Layout from '../../layouts/Layout.astro'

const mrp = 3932; // 2026 год
---

<Layout
  title="Калькулятор налога на криптовалюту — Казахстан 2026"
  description="Рассчитайте ИПН с дохода от криптовалюты в Казахстане. Актуальные ставки и правила налогообложения 2026 года."
  calculator={{
    name: 'Калькулятор налога на криптовалюту — Казахстан 2026',
    description: 'Рассчитайте ИПН с дохода от криптовалюты в Казахстане. Актуальные ставки и правила налогообложения 2026 года.',
  }}
>
  <div class="max-w-6xl mx-auto px-4 py-12 font-sans selection:bg-blue-100">

    <div class="text-center mb-10">
      <h1 class="text-4xl font-black text-gray-900 mb-3 tracking-tight">Налог на крипту</h1>
      <p class="text-gray-500 font-medium">ИПН 10% с прибыли от продажи / вывода — актуально на 2026 год</p>
    </div>

    <div class="grid lg:grid-cols-12 gap-10 items-start">

      <div class="lg:col-span-5 space-y-6">

        <div class="bg-white p-7 rounded-[2.5rem] border border-gray-100 shadow-sm space-y-6">
          <label class="block text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]">Сумма покупки (₸)</label>
          <input
            type="number"
            id="buyAmount"
            placeholder="Например: 500 000"
            class="w-full bg-gray-50 border-none rounded-2xl px-5 py-4 text-3xl font-black focus:ring-2 focus:ring-blue-500 outline-none transition-all"
          />
        </div>

        <div class="bg-white p-7 rounded-[2.5rem] border border-gray-100 shadow-sm space-y-6">
          <label class="block text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]">Сумма продажи / вывода (₸)</label>
          <input
            type="number"
            id="sellAmount"
            placeholder="Например: 800 000"
            class="w-full bg-gray-50 border-none rounded-2xl px-5 py-4 text-3xl font-black focus:ring-2 focus:ring-blue-500 outline-none transition-all"
          />
        </div>

        <button
          id="calcBtn"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-black py-4 rounded-2xl transition-all uppercase tracking-widest shadow-lg shadow-blue-100"
        >
          Рассчитать налог
        </button>

      </div>

      <div class="lg:col-span-7">
        <div class="bg-white border border-gray-100 shadow-2xl rounded-[3rem] p-10 lg:p-14 sticky top-8 overflow-hidden">

          <div class="flex items-center justify-between mb-12">
            <h2 class="text-2xl font-black text-gray-900 tracking-tight">Квитанция</h2>
            <div class="bg-blue-600 text-white text-[10px] font-black px-5 py-1.5 rounded-full uppercase tracking-widest">ИПН 10%</div>
          </div>

          <div class="space-y-8">
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-gray-400 font-medium">Сумма покупки</span>
                <span id="out-buy" class="font-bold text-gray-900">0 ₸</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400 font-medium">Сумма продажи</span>
                <span id="out-sell" class="font-bold text-gray-900">0 ₸</span>
              </div>
            </div>

            <div class="pt-6 border-t border-gray-100">
              <div class="flex justify-between items-center mb-10">
                <span class="text-xs font-black text-gray-500 uppercase tracking-widest">Чистый доход</span>
                <span id="out-profit" class="text-xl font-black text-gray-900">0 ₸</span>
              </div>
              <div class="flex justify-between items-center mb-10">
                <span class="text-xs font-black text-red-500 uppercase tracking-widest">Налог ИПН (10%)</span>
                <span id="out-tax" class="text-3xl font-black text-red-600 underline decoration-red-100 underline-offset-8">0 ₸</span>
              </div>
            </div>

            <div id="no-tax-msg" class="hidden p-6 bg-green-50 rounded-2xl border border-green-100 text-center">
              <p class="text-green-700 font-bold text-sm">Прибыли нет — налог платить не нужно.</p>
            </div>

            <div class="p-10 bg-gray-950 rounded-[2.5rem] text-white shadow-2xl flex flex-col items-center group transition-all hover:scale-[1.02]">
              <span class="text-[10px] font-bold uppercase opacity-40 mb-3 tracking-[0.4em]">Всего к уплате</span>
              <span id="out-total" class="text-5xl font-black tracking-tighter text-blue-400">0 ₸</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</Layout>

<style is:global>
  body { background-color: #f8fafc; }
</style>

<script is:inline>
  const fmt = (n) => Math.round(n).toLocaleString('ru-KZ') + ' ₸';

  function calculate() {
    const buy  = parseFloat(document.getElementById('buyAmount').value)  || 0;
    const sell = parseFloat(document.getElementById('sellAmount').value) || 0;

    document.getElementById('out-buy').textContent  = fmt(buy);
    document.getElementById('out-sell').textContent = fmt(sell);

    const noTaxMsg = document.getElementById('no-tax-msg');

    if (sell > buy) {
      const profit = sell - buy;
      const tax    = profit * 0.10;

      document.getElementById('out-profit').textContent = fmt(profit);
      document.getElementById('out-tax').textContent    = fmt(tax);
      document.getElementById('out-total').textContent  = fmt(tax);
      noTaxMsg.classList.add('hidden');
    } else {
      document.getElementById('out-profit').textContent = fmt(0);
      document.getElementById('out-tax').textContent    = fmt(0);
      document.getElementById('out-total').textContent  = fmt(0);
      if (buy > 0 || sell > 0) noTaxMsg.classList.remove('hidden');
      else noTaxMsg.classList.add('hidden');
    }
  }

  document.getElementById('calcBtn').addEventListener('click', calculate);
  document.getElementById('buyAmount').addEventListener('input', calculate);
  document.getElementById('sellAmount').addEventListener('input', calculate);
</script>
