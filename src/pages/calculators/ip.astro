---
import Layout from '../../layouts/Layout.astro'
import CalcNav from '../../components/CalcNav.astro'
import FaqSection from '../../components/FaqSection.astro'
import FeaturedPosts from '../../components/FeaturedPosts.astro'

const cfg = {
  mzp: 85_000,
  taxSimpl: 0.04,  
  taxPatent: 0.01, 
  taxOUR: 0.10,    
  opvRate: 0.10,
  opvrRate: 0.035, // Ставка 2026 года
  vsmsRate: 0.05,
  vsmsMZP: 1.4,
  soRate: 0.05,
  opvMaxBase: 50,
  soMaxBase: 7
}

const faqs = [
  {
    q: 'Какие налоговые режимы доступны ИП в 2026 году?',
    a: 'Основные режимы: упрощённая декларация (4% от дохода), патент (1% от заявленного дохода) и общеустановленный режим (10% с чистого дохода). Выбор зависит от оборота, вида деятельности и наличия работников.',
  },
  {
    q: 'Какая ставка налога на упрощёнке для ИП?',
    a: 'На упрощённой декларации ставка — 4% от дохода (оборота). Отчётность сдаётся раз в полгода по форме 910.00.',
  },
  {
    q: 'Что такое патент и какая по нему ставка?',
    a: 'Патент — самый простой режим со ставкой 1% от заявленного дохода. Подходит ИП без наёмных работников и с ограниченным перечнем видов деятельности.',
  },
  {
    q: 'Какие социальные платежи ИП платит «за себя»?',
    a: 'ИП уплачивает за себя ОПВ 10%, социальные отчисления (СО) и взносы на медстрахование (ВОСМС) — от заявленного дохода в пределах установленных лимитов.',
  },
  {
    q: 'Когда ИП обязан встать на учёт по НДС?',
    a: 'При превышении оборота 20 000 МРП за календарный год постановка на учёт по НДС обязательна. За несвоевременную постановку предусмотрен штраф.',
  },
  {
    q: 'Что выгоднее — патент или упрощёнка?',
    a: 'Патент дешевле (1% против 4%), но с жёсткими ограничениями по видам деятельности и без права нанимать работников. Упрощёнка позволяет нанимать сотрудников и охватывает больше ОКЭД.',
  },
  {
    q: 'Как часто ИП сдаёт отчётность?',
    a: 'На упрощённой декларации — форма 910.00 два раза в год (за полугодие). На патенте расчёт производится при получении патента на выбранный период.',
  },
  {
    q: 'Платит ли ИП налоги, если не было дохода?',
    a: 'Налог с дохода при нулевом обороте не возникает, однако социальные платежи «за себя» могут уплачиваться исходя из минимального дохода. Отчётность всё равно нужно сдавать.',
  },
  {
    q: 'Что делать, если ИП превысил лимит по упрощёнке?',
    a: 'При превышении лимита по обороту ИП обязан перейти на общеустановленный режим и платить налог с чистого дохода (доходы минус расходы) по ставке 10%.',
  },
  {
    q: 'Какие налоги платит ИП за наёмных работников?',
    a: 'За работников удерживаются ОПВ, ВОСМС и ИПН, а также уплачиваются СО, ОПВР и ООСМС — так же, как и в ТОО. Для расчёта зарплаты используйте калькулятор ТОО.',
  },
]
---

<Layout
  title="Налоговый калькулятор ИП — Казахстан 2026"
  description="Рассчитайте налоги ИП на упрощённом режиме, патенте и общеустановленном режиме. Актуальные ставки 2026 года."
  calculator={{
    name: 'Налоговый калькулятор ИП — Казахстан 2026',
    description: 'Рассчитайте налоги ИП на упрощённом режиме, патенте и общеустановленном режиме. Актуальные ставки 2026 года.',
  }}
>
  <div class="max-w-6xl mx-auto px-4 py-12 font-sans selection:bg-blue-100">
    
    <div class="text-center mb-8">
      <h1 class="text-4xl font-black text-gray-900 mb-3 tracking-tight">Калькулятор налогов для ИП на упрощёнке, патенте и ОУР 2026</h1>
      <p class="text-gray-500 font-medium">Актуальные ставки 2026 года</p>
    </div>

    <CalcNav active="ip" />

    <div class="flex justify-center mb-12">
      <div class="inline-flex bg-gray-100 p-1.5 rounded-2xl border border-gray-200 shadow-inner">
        <button id="period-month" class="period-btn active-tab px-12 py-3 text-sm font-black rounded-xl transition-all uppercase tracking-widest">Месяц</button>
        <button id="period-half" class="period-btn px-12 py-3 text-sm font-black rounded-xl transition-all text-gray-400 uppercase tracking-widest">Полгода</button>
      </div>
    </div>

    <div id="cfg-data" data-cfg={JSON.stringify(cfg)} class="hidden"></div>

    <div class="grid lg:grid-cols-12 gap-10 items-start">
      
      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-white p-7 rounded-[2.5rem] border border-gray-100 shadow-sm">
          <label class="block text-[10px] font-black text-blue-600 uppercase mb-5 tracking-[0.2em]">1. Выберите режим</label>
          <div class="space-y-2">
            <button data-regime="simpl" class="regime-btn active-regime w-full p-5 rounded-2xl border-2 text-left transition-all group">
              <div class="font-bold text-gray-900">ИП на упрощенке</div>
              <div class="text-[10px] opacity-60 mt-1">ИПН 4% от оборота</div>
            </button>
            <button data-regime="patent" class="regime-btn w-full p-5 rounded-2xl border-2 text-left transition-all">
              <div class="font-bold text-gray-900">ИП на патенте</div>
              <div class="text-[10px] opacity-60 mt-1">Налог 1% (без сотрудников)</div>
            </button>
            <button data-regime="our" class="regime-btn w-full p-5 rounded-2xl border-2 text-left transition-all">
              <div class="font-bold text-gray-900">Общеустановленный (ОУР)</div>
              <div class="text-[10px] opacity-60 mt-1">ИПН 10% от чистой прибыли</div>
            </button>
          </div>
        </div>

        <div class="bg-white p-7 rounded-[2.5rem] border border-gray-100 shadow-sm space-y-6">
          <div class="flex items-center justify-between">
            <label class="block text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]">2. Финансы</label>
            
            <label class="inline-flex items-center cursor-pointer group">
              <span class="mr-2 text-[10px] font-bold text-gray-400 uppercase group-hover:text-blue-500 transition-colors">От дохода</span>
              <div class="relative">
                <input type="checkbox" id="check-real-base" class="sr-only peer">
                <div class="w-9 h-5 bg-gray-200 rounded-full peer peer-checked:bg-blue-600 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-full"></div>
              </div>
            </label>
          </div>

          <div>
            <label id="income-label" class="block text-sm font-bold text-gray-700 mb-2">Доход за месяц (₸)</label>
            <input id="inp-income" type="number" placeholder="0" class="w-full bg-gray-50 border-none rounded-2xl px-5 py-4 text-3xl font-black focus:ring-2 focus:ring-blue-500 outline-none transition-all" />
          </div>

          <div id="our-expenses-block" class="hidden animate-fade-in border-t pt-6 border-gray-50">
            <label class="block text-sm font-bold text-red-600 mb-2">Расходы (₸)</label>
            <input id="inp-expenses" type="number" placeholder="0" class="w-full bg-red-50 border-none rounded-2xl px-5 py-4 text-3xl font-black text-red-600 outline-none" />
          </div>
        </div>

        <div id="workers-container" class="bg-white p-7 rounded-[2.5rem] border border-gray-100 shadow-sm">
           <label class="flex items-center justify-between cursor-pointer">
             <div class="flex items-center gap-3">
               <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center">
                 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
               </div>
               <h3 class="font-bold text-gray-800">Наемные работники</h3>
             </div>
             <input type="checkbox" id="check-workers" class="w-6 h-6 rounded-lg border-gray-200 text-blue-600 focus:ring-blue-500 cursor-pointer">
           </label>

           <div id="workers-input-block" class="hidden mt-6 space-y-4 animate-fade-in pt-6 border-t border-gray-100">
             <div class="grid grid-cols-2 gap-4">
               <div>
                 <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Количество</label>
                 <input id="inp-worker-count" type="number" value="1" min="1" class="w-full bg-gray-50 border-none rounded-xl px-4 py-3 font-bold text-lg outline-none" />
               </div>
               <div>
                 <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">ЗП на руки</label>
                 <input id="inp-worker-salary" type="number" placeholder="85000" class="w-full bg-gray-50 border-none rounded-xl px-4 py-3 font-bold text-lg outline-none" />
               </div>
             </div>
           </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="bg-white border border-gray-100 shadow-2xl rounded-[3rem] p-10 lg:p-14 sticky top-8 overflow-hidden">
          
          <div class="flex items-center justify-between mb-12">
            <h2 class="text-2xl font-black text-gray-900 tracking-tight">Квитанция</h2>
            <div id="badge-period" class="bg-blue-600 text-white text-[10px] font-black px-5 py-1.5 rounded-full uppercase tracking-widest">1 месяц</div>
          </div>

          <div class="space-y-8">
            <div class="space-y-4">
              <div class="flex justify-between items-center"><span class="text-gray-400 font-medium">Медстрахование (ВОСМС)</span> <span id="out-vosms" class="font-bold text-gray-900">0 ₸</span></div>
              <div class="flex justify-between items-center"><span class="text-gray-400 font-medium">Пенсионные (ОПВ + ОПВР)</span> <span id="out-opv" class="font-bold text-gray-900">0 ₸</span></div>
              <div class="flex justify-between items-center"><span class="text-gray-400 font-medium">Социальные (СО)</span> <span id="out-so" class="font-bold text-gray-900">0 ₸</span></div>
            </div>

            <div id="out-workers-block" class="hidden pt-6 border-t border-dashed border-gray-100">
              <div class="flex justify-between items-center text-blue-600"><span class="font-bold">Налоги за персонал</span> <span id="out-worker-taxes" class="font-black text-xl">0 ₸</span></div>
            </div>

            <div class="pt-6 border-t border-gray-100">
              <div class="flex justify-between items-center mb-10">
                <span id="tax-label" class="text-xs font-black text-red-500 uppercase tracking-widest">Налог ИПН</span>
                <span id="out-tax-main" class="text-3xl font-black text-red-600 underline decoration-red-100 underline-offset-8">0 ₸</span>
              </div>
            </div>

            <div class="p-10 bg-gray-950 rounded-[2.5rem] text-white shadow-2xl flex flex-col items-center group transition-all hover:scale-[1.02]">
              <span class="text-[10px] font-bold uppercase opacity-40 mb-3 tracking-[0.4em]">Всего к оплате</span>
              <span id="out-total" class="text-5xl font-black tracking-tighter text-blue-400">0 ₸</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <section class="my-16 text-gray-700 leading-relaxed">
      <h2 class="text-2xl font-black text-gray-900 tracking-tight mb-4">Как рассчитать налоги ИП в Казахстане в 2026 году</h2>
      <p class="mb-4">
        Итоговая налоговая нагрузка ИП складывается из двух частей: <strong>налога с дохода</strong> по выбранному
        режиму и <strong>социальных платежей «за себя»</strong> (ОПВ, СО, ВОСМС). Калькулятор считает обе части сразу и
        показывает полную сумму к оплате за месяц или за полугодие — переключатель периода вверху.
      </p>

      <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Три режима налогообложения ИП</h3>
      <ul class="list-disc pl-5 space-y-1 mb-4">
        <li><strong>Упрощённая декларация</strong> — ИПН 4% от оборота (дохода), отчётность по форме 910.00 раз в полгода. Можно нанимать работников.</li>
        <li><strong>Патент</strong> — 1% от заявленного дохода, самый простой режим. Только без наёмных работников и по ограниченному перечню видов деятельности.</li>
        <li><strong>Общеустановленный режим (ОУР)</strong> — ИПН 10% с чистого дохода (доходы минус расходы). Подходит при высоких расходах и превышении лимитов упрощёнки.</li>
      </ul>

      <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Социальные платежи «за себя»</h3>
      <p class="mb-4">
        Независимо от режима ИП платит за себя <strong>ОПВ 10%</strong>, <strong>социальные отчисления (СО) 5%</strong> и
        <strong>ВОСМС</strong>. Базой служит заявленный доход в пределах установленных лимитов, но не ниже 1 МЗП
        (85 000 ₸). ВОСМС уплачивается от фиксированной базы даже при нулевом доходе, а ОПВ и СО при отсутствии дохода
        могут не начисляться — калькулятор учитывает это автоматически.
      </p>

      <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Работники и НДС</h3>
      <p class="mb-4">
        За наёмных сотрудников ИП удерживает и платит те же взносы, что и ТОО (ОПВ, ВОСМС, ИПН, СО, ОПВР, ООСМС) — в
        калькуляторе можно указать их число и зарплату. При обороте свыше <strong>20 000 МРП</strong> за календарный год
        постановка на учёт по НДС обязательна независимо от режима.
      </p>

      <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Что выгоднее — патент или упрощёнка</h3>
      <p class="mb-4">
        Патент дешевле по ставке (1% против 4%), но не позволяет нанимать работников и охватывает меньше видов
        деятельности. Упрощёнка гибче и допускает наём сотрудников. Введите свои цифры в калькуляторе и сравните итоговую
        сумму к оплате по каждому режиму.
      </p>

      <p class="text-sm text-gray-500">
        Расчёт носит справочный характер и использует ставки 2026 года. Для точного учёта лимитов и вычетов обратитесь к
        бухгалтеру.
      </p>
    </section>

    <FeaturedPosts />
    <FaqSection faqs={faqs} />
  </div>
</Layout>

<style is:global>
  body { background-color: #f8fafc; }
  .regime-btn { border-color: #f1f5f9; color: #94a3b8; background: #fff; cursor: pointer; }
  .active-regime { border-color: #2563eb; background: #fff; color: #1e293b !important; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); }
  .period-btn { color: #94a3b8; cursor: pointer; }
  .active-tab { background: #fff; color: #0f172a !important; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
  .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script is:inline>
  const cfg = JSON.parse(document.getElementById('cfg-data').dataset.cfg);
  let currentRegime = 'simpl';
  let currentPeriod = 1; 

  // Функция форматирования: проверяет, является ли n числом
  const fmt = (n) => {
    if (isNaN(n) || n === null || n === undefined) return '0 ₸';
    return Math.round(n).toLocaleString('ru-KZ') + ' ₸';
  };

  function calculate() {
    // Используем || 0, чтобы если поле пустое, подставлялся ноль
    const income = parseFloat(document.getElementById('inp-income').value) || 0;
    const expenses = parseFloat(document.getElementById('inp-expenses').value) || 0;
    const useRealBase = document.getElementById('check-real-base').checked;
    const hasWorkers = document.getElementById('check-workers').checked;
    const m = currentPeriod;

    // 1. БАЗА ДЛЯ СОЦПЛАТЕЖЕЙ
    let base = useRealBase ? income : cfg.mzp;
    if (base < cfg.mzp) base = cfg.mzp; 
    // Если дохода нет совсем, база для ОПВ/СО должна быть 0, а для ВОСМС остается МЗП
    const hasIncome = income > 0;

    // ВОСМС: фиксированная база 1.4 МЗП (платится даже при 0 доходе)
    const vosms = (cfg.mzp * cfg.vsmsMZP * cfg.vsmsRate) * m;
    
    let opv = 0, so = 0;
    if (hasIncome) {
      const opvBase = Math.min(Math.max(base, cfg.mzp), cfg.mzp * cfg.opvMaxBase);
      const soBase = Math.min(Math.max(base, cfg.mzp), cfg.mzp * cfg.soMaxBase);
      
      opv = ((opvBase * cfg.opvRate) + (opvBase * cfg.opvrRate)) * m;
      so = (soBase * cfg.soRate) * m;
    }

    // 2. НАЛОГ РЕЖИМА
    let taxMain = 0;
    if (currentRegime === 'simpl') taxMain = income * cfg.taxSimpl;
    else if (currentRegime === 'patent') taxMain = income * cfg.taxPatent;
    else if (currentRegime === 'our') taxMain = Math.max(0, income - expenses) * cfg.taxOUR;

    // 3. РАБОТНИКИ
    let workerTaxesTotal = 0;
    if (hasWorkers && currentRegime !== 'patent') {
      const count = parseInt(document.getElementById('inp-worker-count').value) || 0;
      const salary = parseFloat(document.getElementById('inp-worker-salary').value) || 0;
      workerTaxesTotal = (count * (salary * 0.21)) * m;
    }

    // ВЫВОД (используем безопасную функцию fmt)
    document.getElementById('out-vosms').textContent = fmt(vosms);
    document.getElementById('out-opv').textContent = fmt(opv);
    document.getElementById('out-so').textContent = fmt(so);
    document.getElementById('out-tax-main').textContent = fmt(taxMain);
    document.getElementById('out-worker-taxes').textContent = fmt(workerTaxesTotal);
    
    const grandTotal = vosms + opv + so + taxMain + workerTaxesTotal;
    document.getElementById('out-total').textContent = fmt(grandTotal);
  }

  // --- ПРИВЯЗКА СОБЫТИЙ (остается прежней) ---
  document.getElementById('period-month').onclick = (e) => setPeriod(1, e.target);
  document.getElementById('period-half').onclick = (e) => setPeriod(6, e.target);

  function setPeriod(p, btn) {
    currentPeriod = p;
    document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active-tab'));
    btn.classList.add('active-tab');
    document.getElementById('badge-period').textContent = p === 1 ? '1 месяц' : 'За полгода';
    calculate();
  }

  document.querySelectorAll('.regime-btn').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.regime-btn').forEach(b => b.classList.remove('active-regime'));
      btn.classList.add('active-regime');
      currentRegime = btn.dataset.regime;
      document.getElementById('our-expenses-block').classList.toggle('hidden', currentRegime !== 'our');
      calculate();
    }
  });

  document.getElementById('check-real-base').onchange = calculate;
  document.getElementById('inp-income').oninput = calculate;
  document.getElementById('inp-expenses').oninput = calculate;
  document.getElementById('inp-worker-count').oninput = calculate;
  document.getElementById('inp-worker-salary').oninput = calculate;
  document.getElementById('check-workers').onchange = (e) => {
    document.getElementById('workers-input-block').classList.toggle('hidden', !e.target.checked);
    calculate();
  };

  calculate();
</script>