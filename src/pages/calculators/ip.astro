---
import Layout from '../../layouts/Layout.astro'
---

<Layout
  title="Калькулятор ИП упрощённый режим 2026"
  description="Рассчитайте налог ИП на упрощённом режиме в Казахстане 2026. 3% от дохода, ОПВ, ВОСМС. Бесплатный онлайн калькулятор."
>

  <div class="mb-8">
    <a href="/" class="text-sm text-gray-400 hover:text-gray-600">← Назад</a>
  </div>

  <h1 class="text-3xl font-bold mb-2">ИП на упрощённом режиме</h1>
  <p class="text-gray-500 mb-10">Налоговая ставка 3% от дохода. Лимит дохода — 24 038 МРП в полугодие (~141 млн тенге).</p>

  <div class="grid md:grid-cols-2 gap-10">

    <!-- Form -->
    <div>
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Доход за полугодие (тенге)
          </label>
          <input
            id="income"
            type="number"
            min="1"
            placeholder="Например: 5 000 000"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-lg focus:outline-none focus:border-blue-400 transition-colors"
          />
          <p id="error-income" class="hidden text-sm text-red-500 mt-1"></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Расходы за полугодие (тенге) <span class="text-gray-400 font-normal">— необязательно</span>
          </label>
          <input
            id="expenses"
            type="number"
            placeholder="Если есть подтверждённые расходы"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-lg focus:outline-none focus:border-blue-400 transition-colors"
          />
          <p class="text-xs text-gray-400 mt-1">На упрощённом режиме налог считается с дохода, расходы не учитываются. Поле для справки.</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Наёмные работники</label>
          <div class="flex gap-3">
            <button id="btn-no-workers" onclick="setWorkers(false)" class="flex-1 border border-blue-400 bg-blue-50 text-blue-700 rounded-xl py-2 text-sm font-medium transition-all">
              Нет работников
            </button>
            <button id="btn-with-workers" onclick="setWorkers(true)" class="flex-1 border border-gray-200 text-gray-600 rounded-xl py-2 text-sm font-medium hover:border-gray-300 transition-all">
              Есть работники
            </button>
          </div>
        </div>

        <div id="workers-block" class="hidden">
          <label class="block text-sm font-medium text-gray-700 mb-1">Кол-во работников</label>
          <input
            id="workers"
            type="number"
            min="1"
            max="30"
            placeholder="1"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-lg focus:outline-none focus:border-blue-400 transition-colors"
          />
          <p id="error-workers" class="hidden text-sm text-red-500 mt-1"></p>
          <p class="text-xs text-gray-400 mt-1">ИПН с зарплаты работников уменьшает налог ИП (до 1.5% от дохода). Максимум 30 чел.</p>
        </div>

        <button
          onclick="calculate()"
          class="w-full bg-blue-600 text-white rounded-xl py-3 font-semibold text-lg hover:bg-blue-700 transition-colors"
        >
          Рассчитать
        </button>
      </div>
    </div>

    <!-- Results -->
    <div id="results" class="hidden">
      <h2 class="font-semibold text-lg mb-4">Результат расчёта</h2>
      <div class="space-y-3">
        <div class="flex justify-between py-3 border-b border-gray-100">
          <span class="text-gray-600">Доход</span>
          <span id="res-income" class="font-medium"></span>
        </div>
        <div class="flex justify-between py-3 border-b border-gray-100">
          <span class="text-gray-600">Налог 3% (ИПН + СН)</span>
          <span id="res-tax" class="font-medium text-red-500"></span>
        </div>
        <div class="flex justify-between py-3 border-b border-gray-100">
          <span class="text-gray-600">ОПВ (10% от дохода, макс. 212 500 тг)</span>
          <span id="res-opv" class="font-medium text-red-500"></span>
        </div>
        <div class="flex justify-between py-3 border-b border-gray-100">
          <span class="text-gray-600">ВОСМС (5% от 1.4 МЗП)</span>
          <span id="res-voсмс" class="font-medium text-red-500"></span>
        </div>
        <div class="flex justify-between py-3 bg-gray-50 rounded-xl px-3 mt-2">
          <span class="font-semibold">Итого к уплате</span>
          <span id="res-total" class="font-bold text-xl text-red-600"></span>
        </div>
        <div class="flex justify-between py-3">
          <span class="text-gray-600">Остаток на руки</span>
          <span id="res-net" class="font-semibold text-green-600 text-lg"></span>
        </div>
      </div>

      <div class="mt-6 bg-blue-50 rounded-xl p-4 text-sm text-blue-800">
        <p class="font-medium mb-1">Когда платить</p>
        <p>Налог по упрощёнке — до 25-го числа второго месяца после полугодия.<br />
        I полугодие → до 25 августа<br />
        II полугодие → до 25 февраля следующего года</p>
      </div>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="flex items-center justify-center text-gray-300 text-sm">
      Введите доход и нажмите «Рассчитать»
    </div>

  </div>

</Layout>

<script>
  let hasWorkers = false

  function setWorkers(val) {
    hasWorkers = val
    document.getElementById('workers-block').classList.toggle('hidden', !val)
    document.getElementById('btn-no-workers').className = !val
      ? 'flex-1 border border-blue-400 bg-blue-50 text-blue-700 rounded-xl py-2 text-sm font-medium transition-all'
      : 'flex-1 border border-gray-200 text-gray-600 rounded-xl py-2 text-sm font-medium hover:border-gray-300 transition-all'
    document.getElementById('btn-with-workers').className = val
      ? 'flex-1 border border-blue-400 bg-blue-50 text-blue-700 rounded-xl py-2 text-sm font-medium transition-all'
      : 'flex-1 border border-gray-200 text-gray-600 rounded-xl py-2 text-sm font-medium hover:border-gray-300 transition-all'
  }

  function fmt(n) {
    return n.toLocaleString('ru-KZ', { maximumFractionDigits: 0 }) + ' тг'
  }

  function calculate() {
    const income = parseFloat(document.getElementById('income').value) || 0
    if (income <= 0) return

    // Ставки 2026
    const MZP = 85000 // МЗП 2026 (уточнить)
    const taxRate = 0.03
    const opvRate = 0.10
    const opvMax = 212500 // 25 МЗП * 10% (приблизительно)
    const vosmsCap = MZP * 1.4 * 0.05

    const tax = income * taxRate
    const opv = Math.min(income * opvRate, opvMax)
    const vosms = vosmsCap

    const total = tax + opv + vosms
    const net = income - total

    document.getElementById('res-income').textContent = fmt(income)
    document.getElementById('res-tax').textContent = fmt(tax)
    document.getElementById('res-opv').textContent = fmt(opv)
    document.getElementById('res-voсмс').textContent = fmt(vosms)
    document.getElementById('res-total').textContent = fmt(total)
    document.getElementById('res-net').textContent = fmt(net)

    document.getElementById('results').classList.remove('hidden')
    document.getElementById('empty-state').classList.add('hidden')
  }

  // Allow Enter key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') calculate()
  })

  // Expose to onclick
  window.calculate = calculate
  window.setWorkers = setWorkers
</script>
