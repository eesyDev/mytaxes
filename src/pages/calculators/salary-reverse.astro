---
import Layout from '../../layouts/Layout.astro'
import SalaryCalculator from '../../components/SalaryCalculator.astro'
import FaqSection from '../../components/FaqSection.astro'
import FeaturedPosts from '../../components/FeaturedPosts.astro'
import { TAX_YEAR } from '../../data/tax-rates-2026.js'

const faqs = [
  {
    q: 'Что такое расчёт зарплаты «от обратного»?',
    a: 'Это расчёт net-to-gross: вы вводите желаемую сумму на руки, а калькулятор подбирает оклад (начисление) и все налоги так, чтобы работник получил именно эту сумму.',
  },
  {
    q: 'Как калькулятор подбирает оклад по сумме на руки?',
    a: 'Методом подбора (бинарный поиск): сумма на руки монотонно растёт вместе с окладом, поэтому нужный оклад находится точно и однозначно, с точностью до тенге.',
  },
  {
    q: 'Учитываются ли дивиденды и больничные в обратном расчёте?',
    a: 'Нет. В обратном режиме подбирается только зарплатная часть — take-home от дивидендов и больничных нельзя однозначно отделить от целевой суммы. Для них используйте прямой расчёт.',
  },
  {
    q: 'Влияет ли режим ОУР или упрощёнка на подобранный оклад?',
    a: 'Нет. Социальный налог платит работодатель сверху, и на сумму «на руки» он не влияет — поэтому оклад одинаков. Отличается только полная стоимость найма.',
  },
  {
    q: 'Что показывает «стоимость найма»?',
    a: 'Это полные расходы работодателя: подобранный оклад плюс все платежи сверху — ОПВР, СО, ООСМС и социальный налог (на ОУР).',
  },
  {
    q: 'Можно ли учесть вычеты и социальные статусы в обратном расчёте?',
    a: 'Да. Базовый вычет 30 МРП, резидентство и льготные статусы (пенсионер, инвалид, многодетная мать и др.) влияют на итоговый подобранный оклад.',
  },
  {
    q: 'Как обратный расчёт работает для нерезидента?',
    a: 'Оклад подбирается с учётом плоской ставки ИПН нерезидента (10% для ЕАЭС временно, 20% для третьих стран) без вычетов и без удержаний в фонды.',
  },
  {
    q: 'Почему при одинаковой сумме на руки оклады получаются разными?',
    a: 'Из-за разных вычетов, ставок ИПН и статусов. Например, у пенсионера нет удержаний ОПВ/ВОСМС, поэтому для той же суммы на руки нужен другой оклад.',
  },
  {
    q: 'Насколько точен подбор оклада?',
    a: 'Подбор итерационный и сходится до 1 тенге: прямой расчёт от найденного оклада вернёт ровно введённую сумму на руки.',
  },
  {
    q: 'Обратный расчёт — это то же самое, что net-to-gross?',
    a: 'Да. «От обратного» означает расчёт от суммы на руки (net) к начисленному окладу (gross) и полной стоимости найма.',
  },
]
---

<Layout
  title={`Расчёт зарплаты от обратного ${TAX_YEAR} — от суммы на руки к окладу`}
  description="Обратный расчёт зарплаты в Казахстане 2026: по желаемой сумме на руки подбираем оклад (gross) и все налоги — ОПВ, ВОСМС, ИПН, СО, ОПВР, ООСМС, СН. ТОО, ставки 2026."
  calculator={{
    name: `Расчёт зарплаты от обратного ${TAX_YEAR}`,
    description: 'По сумме на руки подбираем оклад и полную стоимость найма для ТОО. Ставки 2026 года.',
  }}
>
  <SalaryCalculator
    mode="our"
    direction="reverse"
    active="reverse"
    heading={`Расчёт зарплаты от обратного ${TAX_YEAR}`}
    subheading="От суммы на руки → к окладу и стоимости найма · ТОО"
  />

  <div class="max-w-6xl mx-auto px-4 mt-16">
    <FeaturedPosts />
    <FaqSection faqs={faqs} />
  </div>
</Layout>
