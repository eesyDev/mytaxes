---
import Layout from '../../layouts/Layout.astro'
import CalcNav from '../../components/CalcNav.astro'
import FaqSection from '../../components/FaqSection.astro'
import FeaturedPosts from '../../components/FeaturedPosts.astro'

const faqs = [
  {
    q: 'Что такое форма 240.00 и кто её сдаёт?',
    a: 'Это декларация по индивидуальному подоходному налогу для физлиц с доходами из-за рубежа: иностранные дивиденды, доход от продажи акций, криптовалюты, зарубежная недвижимость. Срок сдачи — до 31 марта следующего года.',
  },
  {
    q: 'Какая ставка ИПН с иностранных дивидендов?',
    a: 'Иностранные дивиденды облагаются ИПН 10%. Налог, удержанный за рубежом, можно зачесть в пределах казахстанской ставки при наличии подтверждающих документов (по соглашению об избежании двойного налогообложения).',
  },
  {
    q: 'Как облагается доход от продажи акций?',
    a: 'ИПН 10% берётся с прироста стоимости — разницы между ценой продажи и ценой покупки. Суммы пересчитываются в тенге по курсу Нацбанка РК на даты операций.',
  },
  {
    q: 'Как считать налог с криптовалюты?',
    a: 'Доход от продажи крипты облагается ИПН 10% с прибыли (цена продажи минус цена покупки). Доход фиксируется в тенге по курсу Нацбанка на дату операции.',
  },
  {
    q: 'По какому курсу пересчитывать валютные доходы?',
    a: 'Все валютные доходы пересчитываются в тенге по официальному курсу Национального банка РК на дату получения дохода.',
  },
  {
    q: 'Что такое зачёт иностранного налога?',
    a: 'Налог, уплаченный (удержанный) за рубежом, уменьшает ИПН к уплате в Казахстане в пределах казахстанской ставки. Зачёт применяется в декларации при наличии подтверждающих документов.',
  },
  {
    q: 'Чем форма 240.00 отличается от 270.00?',
    a: 'Форма 240.00 — для доходов из источников за рубежом (дивиденды, акции, крипта, зарубежная недвижимость). Форма 270.00 — для всеобщего декларирования и прочих доходов физлиц внутри страны.',
  },
  {
    q: 'Когда сроки сдачи декларации и уплаты налога?',
    a: 'Декларация сдаётся до 31 марта года, следующего за отчётным. Уплатить ИПН нужно не позднее 10 календарных дней после срока сдачи декларации.',
  },
  {
    q: 'Нужно ли декларировать доход, если налог за рубежом уже удержан?',
    a: 'Да, доход всё равно подлежит декларированию в форме 240.00. Уплаченный за рубежом налог учитывается через механизм зачёта именно в декларации.',
  },
  {
    q: 'Облагается ли доход на зарубежном брокерском счёте?',
    a: 'Да. Дивиденды и прирост стоимости при продаже ценных бумаг через иностранного брокера подлежат декларированию в форме 240.00 и обложению ИПН.',
  },
]
---

<Layout
  title="Калькулятор Форма 240 — Инвестиции и иностранные доходы 2026"
  description="Рассчитайте ИПН с дивидендов, акций, крипты и зарубежных доходов с учётом курса Нацбанка РК. Форма 240.00."
  calculator={{
    name: 'Калькулятор Форма 240 — Инвестиции и иностранные доходы 2026',
    description: 'Рассчитайте ИПН с дивидендов, акций, крипты и зарубежных доходов с учётом курса Нацбанка РК. Форма 240.00.',
  }}
>
  <div class="max-w-5xl mx-auto px-4 py-12 font-sans selection:bg-blue-100">

    <div class="text-center mb-10">
      <h1 class="text-4xl font-black text-gray-900 mb-3 tracking-tight">Калькулятор 240 формы 2026</h1>
      <div class="inline-flex items-center gap-2 bg-blue-50 px-4 py-2 rounded-full border border-blue-100">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        <p class="text-xs font-bold text-blue-700">Курс НБ РК: <span id="nb-rate">Загрузка...</span> ₸ / $</p>
      </div>
    </div>

    <CalcNav active="forma-240" />

    <div class="grid lg:grid-cols-12 gap-10 items-start">

      <div class="lg:col-span-7 space-y-4">
        
        <p class="text-[11px] font-black text-blue-600 uppercase tracking-[0.2em] mb-2">Выберите доходы за 2025 год</p>

        <div class="income-block bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-md">
          <label class="flex items-center justify-between px-6 py-5 cursor-pointer">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center text-orange-600 font-black text-sm">10%</div>
              <div>
                <p class="font-bold text-gray-900">Иностранные дивиденды (Apple, MSFT и др.)</p>
                <p class="text-xs text-gray-400 mt-0.5">С учетом зачета налогов (Double Tax Treaty)</p>
              </div>
            </div>
            <input type="checkbox" data-block="div-foreign" class="block-toggle w-5 h-5 rounded text-blue-600">
          </label>
          <div id="block-div-foreign" class="hidden border-t border-gray-50 px-6 py-5 space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-[10px] font-bold text-gray-400 uppercase mb-2 block">Сумма ($)</label>
                <input data-input="div-foreign-val" type="number" placeholder="0.00" class="w-full bg-gray-50 rounded-2xl px-4 py-3 text-lg font-black outline-none focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="text-[10px] font-bold text-gray-400 uppercase mb-2 block">Уплачено в США/РФ ($)</label>
                <input data-input="div-foreign-paid" type="number" placeholder="0.00" class="w-full bg-gray-50 rounded-2xl px-4 py-3 text-lg font-black outline-none focus:ring-2 focus:ring-blue-500">
              </div>
            </div>
            <p class="text-[10px] text-gray-400 italic leading-tight">Если за рубежом удержали 10% или более, в РК доплачивать не нужно, но декларация обязательна.</p>
          </div>
        </div>

        <div class="income-block bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden">
          <label class="flex items-center justify-between px-6 py-5 cursor-pointer">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 font-black text-sm">10%</div>
              <div>
                <p class="font-bold text-gray-900">Прирост (Акции / Криптовалюта)</p>
                <p class="text-xs text-gray-400 mt-0.5">Разница между продажей и покупкой</p>
              </div>
            </div>
            <input type="checkbox" data-block="gains" class="block-toggle w-5 h-5 rounded text-blue-600">
          </label>
          <div id="block-gains" class="hidden border-t border-gray-50 px-6 py-5 space-y-4">
             <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-[10px] font-bold text-gray-400 uppercase mb-2 block">Продажа ($)</label>
                <input data-gain="sell" type="number" placeholder="0.00" class="w-full bg-gray-50 rounded-2xl px-4 py-3 text-lg font-black outline-none focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="text-[10px] font-bold text-gray-400 uppercase mb-2 block">Покупка ($)</label>
                <input data-gain="buy" type="number" placeholder="0.00" class="w-full bg-gray-50 rounded-2xl px-4 py-3 text-lg font-black outline-none focus:ring-2 focus:ring-blue-500">
              </div>
            </div>
          </div>
        </div>

        <div class="income-block bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden">
          <label class="flex items-center justify-between px-6 py-5 cursor-pointer">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600 font-black text-sm">10%</div>
              <div>
                <p class="font-bold text-gray-900">Прочие доходы (Аренда, КЗ доходы)</p>
                <p class="text-xs text-gray-400 mt-0.5">Ввод в национальной валюте</p>
              </div>
            </div>
            <input type="checkbox" data-block="other" class="block-toggle w-5 h-5 rounded text-blue-600">
          </label>
          <div id="block-other" class="hidden border-t border-gray-50 px-6 py-5">
            <label class="text-[10px] font-bold text-gray-400 uppercase mb-2 block">Сумма (₸)</label>
            <input data-input="other-kzt" type="number" placeholder="0" class="w-full bg-gray-50 rounded-2xl px-5 py-4 text-2xl font-black outline-none focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

      </div>

      <div class="lg:col-span-5">
        <div class="bg-white border border-gray-100 shadow-2xl rounded-[3rem] p-10 sticky top-8">
          <h2 class="text-2xl font-black text-gray-900 mb-8">Итоговый расчет</h2>

          <div id="breakdown" class="space-y-4 mb-8 min-h-[100px]">
            <p id="empty-state" class="text-sm text-gray-400">Выберите категории слева для начала расчета.</p>
          </div>

          <div class="p-8 bg-gray-950 rounded-[2.5rem] text-white flex flex-col items-center shadow-xl">
            <span class="text-[10px] font-bold uppercase opacity-40 mb-3 tracking-[0.4em]">Налог к уплате (ИПН)</span>
            <span id="out-total" class="text-5xl font-black tracking-tighter text-blue-400">0 ₸</span>
            <div class="flex gap-4 mt-4 opacity-50 text-[10px] uppercase font-bold">
              <span>База: <span id="out-base">0</span> ₸</span>
            </div>
          </div>

          <button onclick="window.print()" class="w-full mt-6 py-4 rounded-2xl border border-gray-200 text-sm font-bold text-gray-500 hover:bg-gray-50 transition-all flex items-center justify-center gap-2">
            <span>🖨️ Распечатать расчет</span>
          </button>
        </div>
      </div>

    </div>

    <div class="mt-16">
      <FeaturedPosts />
      <FaqSection faqs={faqs} />
    </div>
  </div>
</Layout>

<script is:inline>
  let currentRate = 485; // Дефолтный курс

  // 1. Получаем реальный курс через бесплатный API
  async function fetchRate() {
    try {
      const response = await fetch('https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json');
      const data = await response.json();
      currentRate = data.usd.kzt;
      document.getElementById('nb-rate').textContent = currentRate.toFixed(2);
      calculate();
    } catch (e) {
      console.log('Курс не загружен, используем дефолт');
      document.getElementById('nb-rate').textContent = currentRate + ' (оффлайн)';
    }
  }

  const fmt = (n) => Math.round(n).toLocaleString('ru-KZ') + ' ₸';

  function calculate() {
    let totalBaseKzt = 0;
    let totalTaxKzt = 0;
    const lines = [];

    // Дивиденды с зачетом
    const divBlock = document.querySelector('[data-block="div-foreign"]').closest('.income-block');
    if (divBlock.querySelector('.block-toggle').checked) {
      const amountUsd = parseFloat(document.querySelector('[data-input="div-foreign-val"]').value) || 0;
      const paidUsd = parseFloat(document.querySelector('[data-input="div-foreign-paid"]').value) || 0;
      
      const amountKzt = amountUsd * currentRate;
      const taxKzt = amountKzt * 0.10;
      const paidKzt = paidUsd * currentRate;
      
      // Зачет налога: нельзя вернуть деньги из бюджета РК, если там переплатили, поэтому Math.max(0, ...)
      const finalTax = Math.max(0, taxKzt - paidKzt);
      
      if (amountUsd > 0) {
        totalBaseKzt += amountKzt;
        totalTaxKzt += finalTax;
        lines.push({ label: 'Дивиденды (Иностр.)', tax: finalTax });
      }
    }

    // Прирост капитала (Акции/Крипта)
    const gainsBlock = document.querySelector('[data-block="gains"]').closest('.income-block');
    if (gainsBlock.querySelector('.block-toggle').checked) {
      const sellUsd = parseFloat(document.querySelector('[data-gain="sell"]').value) || 0;
      const buyUsd = parseFloat(document.querySelector('[data-gain="buy"]').value) || 0;
      
      const gainUsd = Math.max(0, sellUsd - buyUsd);
      const gainKzt = gainUsd * currentRate;
      const taxKzt = gainKzt * 0.10;

      if (gainUsd > 0) {
        totalBaseKzt += gainKzt;
        totalTaxKzt += taxKzt;
        lines.push({ label: 'Прирост стоимости', tax: taxKzt });
      }
    }

    // Прочее (Тенге)
    const otherBlock = document.querySelector('[data-block="other"]').closest('.income-block');
    if (otherBlock.querySelector('.block-toggle').checked) {
      const amountKzt = parseFloat(document.querySelector('[data-input="other-kzt"]').value) || 0;
      const taxKzt = amountKzt * 0.10;

      if (amountKzt > 0) {
        totalBaseKzt += amountKzt;
        totalTaxKzt += taxKzt;
        lines.push({ label: 'Прочие доходы', tax: taxKzt });
      }
    }

    // Рендер
    const breakdown = document.getElementById('breakdown');
    if (lines.length === 0) {
      breakdown.innerHTML = '<p id="empty-state" class="text-sm text-gray-400">Выберите категории слева для начала расчета.</p>';
    } else {
      breakdown.innerHTML = lines.map(l => `
        <div class="flex justify-between items-center animate-fade-in py-2 border-b border-gray-50">
          <span class="text-sm text-gray-500 font-medium">${l.label}</span>
          <span class="font-black text-gray-900">${fmt(l.tax)}</span>
        </div>
      `).join('');
    }

    document.getElementById('out-base').textContent = Math.round(totalBaseKzt).toLocaleString('ru-KZ');
    document.getElementById('out-total').textContent = fmt(totalTaxKzt);
  }

  // Event Listeners
  document.querySelectorAll('.block-toggle').forEach(toggle => {
    toggle.addEventListener('change', () => {
      const blockId = 'block-' + toggle.dataset.block;
      document.getElementById(blockId).classList.toggle('hidden', !toggle.checked);
      calculate();
    });
  });

  document.querySelectorAll('input').forEach(input => {
    input.addEventListener('input', calculate);
  });

  fetchRate(); // Старт
</script>

<style is:global>
  @keyframes fadeIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
  .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
  input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
</style>