---
import Layout from '../../layouts/Layout.astro'
import SalaryCalculator from '../../components/SalaryCalculator.astro'
import FaqSection from '../../components/FaqSection.astro'
import FeaturedPosts from '../../components/FeaturedPosts.astro'
import { TAX_YEAR } from '../../data/tax-rates-2026.js'

const faqs = [
  {
    q: 'Какие налоги удерживаются из зарплаты работника ТОО на ОУР?',
    a: 'Из зарплаты удерживаются ОПВ 10%, ВОСМС 2% и ИПН 10% (15% с части дохода свыше 8 500 МРП за год). Остальные платежи начисляет работодатель сверх оклада.',
  },
  {
    q: 'Что платит работодатель сверх оклада на общеустановленном режиме?',
    a: 'Работодатель платит ОПВР 3,5%, социальные отчисления (СО) 5%, ООСМС 3% и социальный налог 6%. Эти суммы формируют полную стоимость найма.',
  },
  {
    q: 'Как считается ИПН с зарплаты?',
    a: 'ИПН 10% берётся с базы: оклад минус ОПВ, минус ВОСМС, минус налоговые вычеты. Базовый вычет 30 МРП (129 750 ₸) существенно снижает базу, а при низкой зарплате обнуляет ИПН.',
  },
  {
    q: 'Что такое базовый вычет 30 МРП?',
    a: 'С 2026 года базовый вычет по ИПН — 30 МРП (129 750 ₸ в месяц). Доступен резидентам РК по основному месту работы при наличии заявления и уменьшает облагаемую базу.',
  },
  {
    q: 'Есть ли минимальная база для взносов работодателя?',
    a: 'Да, для СО, ОПВР и ООСМС минимальная база — 1 МЗП (85 000 ₸). Если зарплата ниже, взносы считаются от минимума. Исключение — месяц найма или увольнения.',
  },
  {
    q: 'Как считается социальный налог на ОУР?',
    a: 'Социальный налог — 6% от базы (оклад минус ОПВ минус ВОСМС). С 2026 года взаимозачёт с социальными отчислениями отменён — соцналог платится «чистыми».',
  },
  {
    q: 'Как рассчитать зарплату при приёме или увольнении в середине месяца?',
    a: 'Оклад делится пропорционально отработанным дням. В месяц найма или увольнения минимальные базы по СО/ОПВР/ООСМС/соцналогу не применяются — берётся фактический доход. Вычет 30 МРП при этом остаётся полным.',
  },
  {
    q: 'Чем отличается расчёт по договору ГПХ?',
    a: 'При договоре ГПХ социальные отчисления (СО) удерживаются из дохода исполнителя, а работодатель не платит ОПВР, ООСМС и социальный налог. ОПВ и ВОСМС удерживаются как обычно.',
  },
  {
    q: 'Как считается зарплата нерезидента?',
    a: 'У нерезидента (третьи страны) ИПН — плоские 20% от дохода без вычетов; ОПВ/ВОСМС/СО/ОПВР/ООСМС не начисляются, остаётся только социальный налог. У граждан ЕАЭС, временно пребывающих, трудовой ИПН — 10%.',
  },
  {
    q: 'Как облагаются дивиденды учредителю ТОО?',
    a: 'Дивиденды резидента облагаются ИПН 5% (15% с части свыше 230 000 МРП за год). ОПВ, ВОСМС и социальные отчисления на дивиденды не начисляются.',
  },
]
---

<Layout
  title={`Калькулятор зарплаты ТОО на ОУР ${TAX_YEAR}`}
  description="Расчёт зарплаты на руки и налогов работодателя для ТОО на общеустановленном режиме (ОУР) в Казахстане 2026: ОПВ, ВОСМС, ИПН, СО, ОПВР, ООСМС, СН. С вычетами и льготами."
  calculator={{
    name: `Калькулятор зарплаты ТОО на ОУР ${TAX_YEAR}`,
    description: 'Расчёт зарплаты на руки и полной стоимости найма для ТОО на общеустановленном режиме (ОУР). Ставки 2026 года.',
  }}
>
  <SalaryCalculator
    mode="our"
    direction="direct"
    active="too-our"
    heading={`Калькулятор зарплаты и налогов для ТОО на общеустановленном режиме ${TAX_YEAR}`}
    subheading="Зарплата на руки и стоимость найма · ТОО · общеустановленный режим"
  />

  <section class="my-16 text-gray-700 leading-relaxed">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight mb-4">Как рассчитать зарплату и налоги ТОО на ОУР в {TAX_YEAR} году</h2>
    <p class="mb-4">
      Общеустановленный режим (ОУР) — базовая система налогообложения для ТОО в Казахстане. При расчёте зарплаты
      работника на ОУР часть платежей <strong>удерживается из оклада</strong>, а часть работодатель платит
      <strong>сверх оклада</strong>, формируя полную стоимость найма. Наш калькулятор считает обе стороны сразу:
      сколько работник получит на руки и во сколько сотрудник обходится компании.
    </p>

    <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Что удерживается из зарплаты работника</h3>
    <ul class="list-disc pl-5 space-y-1 mb-4">
      <li><strong>ОПВ</strong> — обязательные пенсионные взносы, 10% от оклада;</li>
      <li><strong>ВОСМС</strong> — взносы на медстрахование, 2% от оклада;</li>
      <li><strong>ИПН</strong> — подоходный налог 10% с базы «оклад − ОПВ − ВОСМС − вычеты» (15% с части дохода свыше 8 500 МРП за год).</li>
    </ul>

    <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Что платит работодатель сверх оклада</h3>
    <ul class="list-disc pl-5 space-y-1 mb-4">
      <li><strong>ОПВР</strong> — обязательные пенсионные взносы работодателя, 3,5%;</li>
      <li><strong>СО</strong> — социальные отчисления, 5%;</li>
      <li><strong>ООСМС</strong> — отчисления на медстрахование, 3%;</li>
      <li><strong>Социальный налог</strong> — 6% от базы. С 2026 года взаимозачёт соцналога с социальными отчислениями отменён, поэтому на ОУР соцналог платится «чистыми».</li>
    </ul>

    <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Вычеты и льготы</h3>
    <p class="mb-4">
      Базовый вычет <strong>30 МРП (129 750 ₸)</strong> уменьшает облагаемую базу ИПН и доступен резидентам РК по
      основному месту работы. Для СО, ОПВР и ООСМС действует минимальная база в размере 1 МЗП (85 000 ₸) — если оклад
      ниже, взносы считаются от минимума. В калькуляторе можно учесть статус пенсионера, инвалида, студента,
      многодетной матери, а также льготные режимы Astana Hub и МФЦА — каждый из них по-своему меняет набор платежей.
    </p>

    <h3 class="text-lg font-bold text-gray-900 mt-8 mb-3">Неполный месяц и договор ГПХ</h3>
    <p class="mb-4">
      В месяц найма или увольнения оклад делится пропорционально отработанным дням, при этом минимальные базы по
      СО/ОПВР/ООСМС/соцналогу не применяются — берётся фактический доход. По договору ГПХ социальные отчисления (СО)
      удерживаются из дохода исполнителя, а работодатель не платит ОПВР, ООСМС и социальный налог.
    </p>

    <p class="text-sm text-gray-500">
      Расчёт носит справочный характер и использует ставки {TAX_YEAR} года. Для точного помесячного учёта ИПН
      нарастающим итогом обратитесь к бухгалтеру.
    </p>
  </section>

  <FeaturedPosts />
  <FaqSection faqs={faqs} />
</Layout>
