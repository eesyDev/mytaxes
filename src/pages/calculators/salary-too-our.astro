---
import Layout from '../../layouts/Layout.astro'
import SalaryCalculator from '../../components/SalaryCalculator.astro'
import FaqSection from '../../components/FaqSection.astro'
import FeaturedPosts from '../../components/FeaturedPosts.astro'
import { TAX_YEAR } from '../../data/tax-rates-2026.js'

const faqs = [
  {
    q: 'Какие налоги удерживаются из зарплаты работника ТОО на ОУР?',
    a: 'Из зарплаты удерживаются ОПВ 10%, ВОСМС 2% и ИПН 10% (15% с части дохода свыше 8 500 МРП за год). Остальные платежи начисляет работодатель сверх оклада.',
  },
  {
    q: 'Что платит работодатель сверх оклада на общеустановленном режиме?',
    a: 'Работодатель платит ОПВР 3,5%, социальные отчисления (СО) 5%, ООСМС 3% и социальный налог 6%. Эти суммы формируют полную стоимость найма.',
  },
  {
    q: 'Как считается ИПН с зарплаты?',
    a: 'ИПН 10% берётся с базы: оклад минус ОПВ, минус ВОСМС, минус налоговые вычеты. Базовый вычет 30 МРП (129 750 ₸) существенно снижает базу, а при низкой зарплате обнуляет ИПН.',
  },
  {
    q: 'Что такое базовый вычет 30 МРП?',
    a: 'С 2026 года базовый вычет по ИПН — 30 МРП (129 750 ₸ в месяц). Доступен резидентам РК по основному месту работы при наличии заявления и уменьшает облагаемую базу.',
  },
  {
    q: 'Есть ли минимальная база для взносов работодателя?',
    a: 'Да, для СО, ОПВР и ООСМС минимальная база — 1 МЗП (85 000 ₸). Если зарплата ниже, взносы считаются от минимума. Исключение — месяц найма или увольнения.',
  },
  {
    q: 'Как считается социальный налог на ОУР?',
    a: 'Социальный налог — 6% от базы (оклад минус ОПВ минус ВОСМС). С 2026 года взаимозачёт с социальными отчислениями отменён — соцналог платится «чистыми».',
  },
  {
    q: 'Как рассчитать зарплату при приёме или увольнении в середине месяца?',
    a: 'Оклад делится пропорционально отработанным дням. В месяц найма или увольнения минимальные базы по СО/ОПВР/ООСМС/соцналогу не применяются — берётся фактический доход. Вычет 30 МРП при этом остаётся полным.',
  },
  {
    q: 'Чем отличается расчёт по договору ГПХ?',
    a: 'При договоре ГПХ социальные отчисления (СО) удерживаются из дохода исполнителя, а работодатель не платит ОПВР, ООСМС и социальный налог. ОПВ и ВОСМС удерживаются как обычно.',
  },
  {
    q: 'Как считается зарплата нерезидента?',
    a: 'У нерезидента (третьи страны) ИПН — плоские 20% от дохода без вычетов; ОПВ/ВОСМС/СО/ОПВР/ООСМС не начисляются, остаётся только социальный налог. У граждан ЕАЭС, временно пребывающих, трудовой ИПН — 10%.',
  },
  {
    q: 'Как облагаются дивиденды учредителю ТОО?',
    a: 'Дивиденды резидента облагаются ИПН 5% (15% с части свыше 230 000 МРП за год). ОПВ, ВОСМС и социальные отчисления на дивиденды не начисляются.',
  },
]
---

<Layout
  title={`Калькулятор зарплаты ТОО на ОУР ${TAX_YEAR}`}
  description="Расчёт зарплаты на руки и налогов работодателя для ТОО на общеустановленном режиме (ОУР) в Казахстане 2026: ОПВ, ВОСМС, ИПН, СО, ОПВР, ООСМС, СН. С вычетами и льготами."
  calculator={{
    name: `Калькулятор зарплаты ТОО на ОУР ${TAX_YEAR}`,
    description: 'Расчёт зарплаты на руки и полной стоимости найма для ТОО на общеустановленном режиме (ОУР). Ставки 2026 года.',
  }}
>
  <SalaryCalculator
    mode="our"
    direction="direct"
    active="too-our"
    heading={`Калькулятор зарплаты ТОО на ОУР ${TAX_YEAR}`}
    subheading="Зарплата на руки и стоимость найма · ТОО · общеустановленный режим"
  />

  <div class="max-w-6xl mx-auto px-4 mt-16">
    <FeaturedPosts />
    <FaqSection faqs={faqs} />
  </div>
</Layout>
