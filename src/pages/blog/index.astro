---
import Layout from '../../layouts/Layout.astro'

// Используем нативный import.meta.glob вместо глючного Astro.glob
const files = await import.meta.glob('./*.astro', { eager: true });
const allFiles = Object.values(files);

// Исключаем саму страницу index.astro
const posts = allFiles.filter((file: any) => file.file && !file.file.endsWith('index.astro'));
---

<Layout title="Статьи о налогах Казахстан 2026" description="Полезные статьи о налогах для ИП и ТОО в Казахстане.">

  <h1 class="text-3xl font-bold mb-2">Статьи о налогах</h1>
  <p class="text-gray-500 mb-10">Понятно о налогах в Казахстане. Без воды.</p>

  <div class="space-y-4">
    
    {/* 3. Запускаем цикл (map), который сам создаст карточку для каждой статьи */}
    {posts.map((post) => (
      <a href={post.url} class="group flex gap-4 border border-gray-100 rounded-2xl p-6 hover:border-gray-300 transition-all shadow-sm hover:shadow-md bg-white">
        <div class="flex-1">
          {/* Берем категорию из файла статьи. Если ее нет, пишем 'Статья' */}
          <span class="text-xs text-gray-400 font-bold uppercase tracking-wide">
            {post.category || 'Статья'}
          </span>
          
          <h2 class="font-black text-xl mt-1 mb-2 text-gray-900 group-hover:text-blue-600 transition-colors">
            {post.title}
          </h2>
          
          <p class="text-sm text-gray-500 font-medium">
            {post.description}
          </p>
        </div>
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-50 group-hover:bg-blue-50 transition-colors self-center">
          <span class="text-gray-400 group-hover:text-blue-600 font-bold text-xl">→</span>
        </div>
      </a>
    ))}

  </div>

</Layout>