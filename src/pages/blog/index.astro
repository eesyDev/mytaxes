---
import Layout from '../../layouts/Layout.astro'

const modules = import.meta.glob('./*.astro', { eager: true })

const posts = Object.entries(modules)
  .filter(([, mod]) => mod.meta)
  .map(([path, mod]) => ({
    ...mod.meta,
    slug: path.replace('./', '').replace('.astro', ''),
  }))

const reviewedSlugs = new Set([
  'snr-2026', 'nds-porog', 'nalogovye-vychety',
  'pochemu-raschet-zarplaty-otlichaetsya', 'oklad-ot-summy-na-ruki',
  'mzp-2027', 'mrp-2027', 'ipn-2027', 'forma-910-2-polugodie-2026',
])
const reviewedPosts = posts.filter((post) => reviewedSlugs.has(post.slug))
  .sort((a, b) => (b.datePublished ?? '2026-10-10').localeCompare(a.datePublished ?? '2026-10-10'))
const formatDate = (value: string) => new Intl.DateTimeFormat('ru-KZ', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`))
---

<Layout
  title="Статьи о налогах Казахстана: 2026 и изменения 2027 года"
  description="Налоги для ИП, ТОО и физлиц: правила 2026 года, предварительные показатели 2027, расчёты и сроки отчётности."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: 'Главная', item: 'https://mytaxes.kz' },
    { name: 'Статьи о налогах' },
  ]}
>

  <h1 class="text-3xl font-bold mb-2">Статьи о налогах</h1>
  <p class="text-gray-500 mb-10">Понятно о налогах в Казахстане. Без воды.</p>

  <div class="space-y-4">
    {reviewedPosts.map(post => (
      <a href={`/blog/${post.slug}`} class="group flex gap-4 border border-gray-200 rounded-2xl p-6 hover:border-gray-300 transition-all">
        <div class="flex-1">
          <span class="text-xs text-gray-400 uppercase tracking-wide">{post.category}</span>
          <h2 class="font-semibold text-lg mt-1 mb-2 group-hover:text-blue-600 transition-colors">
            {post.title}
          </h2>
          <p class="text-sm text-gray-500">
            {post.description}
          </p>
          <p class="mt-3 text-xs text-gray-500">
            Опубликовано: <time datetime={post.datePublished ?? '2026-10-10'}>{formatDate(post.datePublished ?? '2026-10-10')}</time>
            {' · '}Обновлено: <time datetime={post.dateModified ?? '2026-10-10'}>{formatDate(post.dateModified ?? '2026-10-10')}</time>
          </p>
        </div>
        <span class="text-gray-300 self-center text-xl">→</span>
      </a>
    ))}
  </div>

</Layout>
