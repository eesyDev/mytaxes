---
import Layout from '../../layouts/Layout.astro'

const modules = import.meta.glob('./*.astro', { eager: true })

const posts = Object.entries(modules)
  .filter(([, mod]) => mod.meta)
  .map(([path, mod]) => ({
    ...mod.meta,
    slug: path.replace('./', '').replace('.astro', ''),
  }))
---

<Layout title="Статьи о налогах Казахстан 2026" description="Полезные статьи о налогах для ИП и ТОО в Казахстане. Разборы ставок, сроков, режимов налогообложения 2026.">

  <h1 class="text-3xl font-bold mb-2">Статьи о налогах</h1>
  <p class="text-gray-500 mb-10">Понятно о налогах в Казахстане. Без воды.</p>

  <div class="space-y-4">
    {posts.map(post => (
      <a href={`/blog/${post.slug}`} class="group flex gap-4 border border-gray-200 rounded-2xl p-6 hover:border-gray-300 transition-all">
        <div class="flex-1">
          <span class="text-xs text-gray-400 uppercase tracking-wide">{post.category}</span>
          <h2 class="font-semibold text-lg mt-1 mb-2 group-hover:text-blue-600 transition-colors">
            {post.title}
          </h2>
          <p class="text-sm text-gray-500">
            {post.description}
          </p>
        </div>
        <span class="text-gray-300 self-center text-xl">→</span>
      </a>
    ))}
  </div>

</Layout>
